
@model List<PersonalAgent.Web.ViewModels.IssueDetailsViewModel>

@{
    ViewData["Title"] = "Saker";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Saker</h1>

    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="Issues"
           asp-action="Create"
           asp-route-projectId="@ViewBag.ProjectId"
           class="btn btn-primary">
            Opprett ny sak
        </a>
    }
</div>

@if (TempData["Success"] is string message)
{
    <div class="alert alert-success">
        @message
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Ingen saker er registrert ennå.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>ID</th>
            <th>Tittel</th>
            <th>Prosjekt</th>
            <th>Status</th>
            <th>Opprettet</th>
            <th>Handlinger</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var issue in Model)
        {
            <tr>
                <td>@issue.Id</td>
                <td>@issue.Title</td>
                <td>
                    <a asp-controller="Projects"
                       asp-action="Details"
                       asp-route-id="@issue.ProjectId">
                        @issue.ProjectName
                    </a>
                </td>
                <td>
                    @switch (issue.Status)
                    {
                        case PersonalAgent.Core.Enums.IssueStatus.Open:
                            <span class="badge bg-secondary">Åpen</span>
                            break;

                        case PersonalAgent.Core.Enums.IssueStatus.InProgress:
                            <span class="badge bg-primary">Pågår</span>
                            break;

                        case PersonalAgent.Core.Enums.IssueStatus.Closed:
                            <span class="badge bg-success">Lukket</span>
                            break;
                            
                        case PersonalAgent.Core.Enums.IssueStatus.Assigned:
                            <span class="badge bg-info text-dark">Tildelt</span>
                            break;
                    }
                </td>
                <td>@issue.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@issue.Id"
                       class="btn btn-sm btn-outline-primary">
                        Vis
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@issue.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Rediger
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@issue.Id"
                           class="btn btn-sm btn-outline-danger">
                            Slett
                        </a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
