@using Microsoft.AspNetCore.Identity
@using PersonalAgent.Infrastructure.Identity

@inject SignInManager<MvcApplicationUser> SignInManager
@inject UserManager<MvcApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link text-dark">
                @User.Identity?.Name
            </span>
        </li>

        <li class="nav-item">
            @if (User.IsInRole("Admin"))
            {
                <span class="nav-link fw-bold text-success">
                    Administrator
                </span>
            }
            else if (User.IsInRole("User"))
            {
                <span class="nav-link text-secondary">
                    Bruker
                </span>
            }
            else
            {
                <span class="nav-link text-warning">
                    Ingen rolle
                </span>
            }
        </li>

        <li class="nav-item">
            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                  method="post">
                <button type="submit"
                        class="nav-link btn btn-link text-dark">
                    Logg ut
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-area="Identity"
               asp-page="/Account/Register">
                Registrer
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-area="Identity"
               asp-page="/Account/Login">
                Logg inn
            </a>
        </li>
    }
</ul>